// MODELO DE DATOS
// Los archivos .prisma describen las tablas de la base de datos: sus campos, tipos y relaciones.
// Está dividido por tema para que sea fácil de encontrar y mantener.
// Este archivo: Configuración general de Prisma: qué cliente se genera y qué tipo de base de datos se usa (MySQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}
