generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model carrito {
  id          String        @id
  usuarioId   String        @unique(map: "Carrito_usuarioId_key")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  usuario     usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "Carrito_usuarioId_fkey")
  itemcarrito itemcarrito[]

  @@index([usuarioId], map: "Carrito_usuarioId_idx")
}

model disenoguardado {
  id            String        @id
  nombre        String        @db.VarChar(120)
  descripcion   String?       @db.Text
  configuracion String        @db.LongText
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  usuarioId     String
  usuario       usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "DisenoGuardado_usuarioId_fkey")
  itemcarrito   itemcarrito[]

  @@index([usuarioId], map: "DisenoGuardado_usuarioId_idx")
}

model gabinete {
  id                   String                  @id @default(uuid())
  nombre               String                  @db.VarChar(150)
  marca                String                  @db.VarChar(150)
  costoUnitario        Decimal                 @db.Decimal(10, 2)
  stockActual          Int                     @default(0)
  stockMinimo          Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  activo               Boolean                 @default(true)
  formato              gabinete_formato
  materialChasis       gabinete_materialChasis
  panel                gabinete_panel
  tamano               gabinete_tamano
  categoriaId          String?
  categoria            CategoriaProducto?      @relation(fields: [categoriaId], references: [id], onDelete: SetNull, map: "Gabinete_categoriaId_fkey")
  inventariomovimiento inventariomovimiento[]
  itemcarrito          itemcarrito[]

  @@index([categoriaId], map: "Gabinete_categoriaId_idx")
}

model CategoriaProducto {
  id          String     @id @default(uuid())
  nombre      String     @unique @db.VarChar(100)
  descripcion String?    @db.Text
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  productos   gabinete[]
}

model inventariomovimiento {
  id         String                    @id
  materialId String?
  tipo       inventariomovimiento_tipo
  cantidad   Int
  motivo     String?
  referencia String?
  fecha      DateTime                  @default(now())
  usuarioId  String?
  createdAt  DateTime                  @default(now())
  gabineteId String?
  gabinete   gabinete?                 @relation(fields: [gabineteId], references: [id], map: "InventarioMovimiento_gabineteId_fkey")
  material   material?                 @relation(fields: [materialId], references: [id], onDelete: Cascade, map: "InventarioMovimiento_materialId_fkey")
  usuario    usuario?                  @relation(fields: [usuarioId], references: [id], map: "InventarioMovimiento_usuarioId_fkey")

  @@index([gabineteId], map: "InventarioMovimiento_gabineteId_fkey")
  @@index([materialId], map: "InventarioMovimiento_materialId_fkey")
  @@index([usuarioId], map: "InventarioMovimiento_usuarioId_fkey")
}

model itemcarrito {
  id               String          @id
  carritoId        String
  gabineteId       String?
  disenoGuardadoId String?
  cantidad         Int             @default(1)
  precioUnitario   Decimal         @db.Decimal(10, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  carrito          carrito         @relation(fields: [carritoId], references: [id], onDelete: Cascade, map: "ItemCarrito_carritoId_fkey")
  disenoguardado   disenoguardado? @relation(fields: [disenoGuardadoId], references: [id], map: "ItemCarrito_disenoGuardadoId_fkey")
  gabinete         gabinete?       @relation(fields: [gabineteId], references: [id], map: "ItemCarrito_gabineteId_fkey")

  @@index([carritoId], map: "ItemCarrito_carritoId_idx")
  @@index([disenoGuardadoId], map: "ItemCarrito_disenoGuardadoId_idx")
  @@index([gabineteId], map: "ItemCarrito_gabineteId_idx")
}

model material {
  id                   String                 @id
  nombre               String                 @db.VarChar(150)
  codigo               String                 @unique(map: "Material_codigo_key") @db.VarChar(50)
  categoria            material_categoria
  unidadMedida         material_unidadMedida
  stockActual          Int                    @default(0)
  stockMinimo          Int                    @default(0)
  costoUnitario        Decimal?               @db.Decimal(10, 2)
  descripcion          String?                @db.Text
  activo               Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  inventariomovimiento inventariomovimiento[]
}

model tokenacceso {
  id        String           @id
  tokenHash String           @unique(map: "TokenAcceso_tokenHash_key")
  tipo      tokenacceso_tipo
  expiraEn  DateTime
  usado     Boolean          @default(false)
  creadoEn  DateTime         @default(now())
  usuarioId String
  usuario   usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade, map: "TokenAcceso_usuarioId_fkey")

  @@index([expiraEn], map: "TokenAcceso_expiraEn_idx")
  @@index([usuarioId, tipo], map: "TokenAcceso_usuarioId_tipo_idx")
}

model usuario {
  id                   String                 @id
  nombre               String
  apellido             String
  email                String                 @unique(map: "Usuario_email_key")
  passwordHash         String
  telefono             String?
  fechaRegistro        DateTime               @default(now())
  emailVerificado      Boolean                @default(false)
  rol                  usuario_rol            @default(CLIENTE)
  carrito              carrito?
  disenoguardado       disenoguardado[]
  inventariomovimiento inventariomovimiento[]
  tokenacceso          tokenacceso[]
}

enum inventariomovimiento_tipo {
  ENTRADA
  SALIDA
  AJUSTE
}

enum tokenacceso_tipo {
  VERIFICACION_EMAIL
  RECUPERACION_PASSWORD
}

enum material_categoria {
  MDF
  MELAMINA
  METAL
  VIDRIO
  ACERO
  ACCESORIO
  OTRO
}

enum material_unidadMedida {
  UNIDAD
  KG
  M
  M2
  CM
  LATA
  BOLSA
}

enum usuario_rol {
  CLIENTE
  ADMIN
}

enum gabinete_formato {
  ATX
  MICRO_ATX
  ITX
}

enum gabinete_materialChasis {
  ACERO
  ALUMINIO
}

enum gabinete_panel {
  VIDRIO_TEMPLADO
  ACRILICO
  MALLADO
}

enum gabinete_tamano {
  FULL_TOWER
  MID_TOWER
  MINI_TOWER
}