# Conexión a MySQL: mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB
# MAMP usa el puerto 8889 (root/root); MySQL estándar usa 3306.
# Cada persona debe crear su propia base de datos vacía.
DATABASE_URL=mysql://root:root@localhost:8889/graffiart_db

PORT=3000
NODE_ENV=development

# Secreto para firmar los tokens (mínimo 16 caracteres)
JWT_SECRET=reemplazar_por_un_secreto_largo
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:5173

# Administrador que crean el seed y el script crear-admin
ADMIN_EMAIL=admin@graffiart.com
ADMIN_PASSWORD=cambiar_esta_clave
